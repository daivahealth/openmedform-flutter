          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "assessment": {
                    "type": "object",
                    "properties": {
                      "spo2": {
                        "type": "integer",
                        "maximum": 91
                      }
                    },
                    "required": [
                      "spo2"
                    ]
                  }
                },
                "required": [
                  "assessment"
                ]
              },
              "then": {
                "required": [
                  "recommendation"
                ]
              }
            }
          ]
        },
        {
          "callDetails": {},
          "reasonForCall": {},
          "assessment": {}
