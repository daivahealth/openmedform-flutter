    {
      "name": "prunes empty leaves keeping false and zero",
      "fn": "pruneEmptyValues",
      "args": [
        {
          "a": "",
          "b": null,
          "d": {
            "e": ""
          },
          "keepFalse": false,
          "keepZero": 0,
          "nested": {
            "x": 1,
            "y": ""
          }
        }
      ],
      "expected": {
        "keepFalse": false,
        "keepZero": 0,
        "nested": {
          "x": 1
        }
      }
    },
    {
      "name": "prunes array items element-wise",
